# ============================================================
# ExpenseGuard CE-2 — Environment Configuration
# Copy this file to .env and configure with your credentials.
# ============================================================

# Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# 1. MongoDB Atlas Connection
# Replace with your MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/expenseguard?retryWrites=true&w=majority
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://expenseguard_app:muskan25@muskan.omnojp4.mongodb.net/expenseguard?retryWrites=true&w=majority
# ------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-Side)
# Option A: Path to your downloaded serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./server/config/serviceAccountKey.json

# Option B: Or individual Firebase Admin credentials (alternative to JSON file)
